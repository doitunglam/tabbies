{
  "name": "tabbies",
  "displayName": "Tabbies",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Watch one tab as a floating bubble inside every other tab.",
  "license": "MIT",
  "homepage": "https://github.com/doitunglam/tabbies#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doitunglam/tabbies.git"
  },
  "bugs": {
    "url": "https://github.com/doitunglam/tabbies/issues"
  },
  "keywords": [
    "chrome-extension",
    "picture-in-picture",
    "tabcapture",
    "webrtc",
    "manifest-v3"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b --force"
  },
  "dependencies": {
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-zip-pack": "^1.2.4",
    "vue-tsc": "^3.2.5"
  }
}
